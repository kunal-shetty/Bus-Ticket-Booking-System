<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.BookingHistoryController"
            prefWidth="800" prefHeight="600">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox alignment="CENTER" spacing="4" styleClass="page-header">
            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <Label text="📄 My Bookings"
                   styleClass="header-label"/>

            <Label text="View your past and upcoming trips"
                   styleClass="sub-header"/>
        </VBox>
    </top>

    <!-- ===== CENTER ===== -->
    <center>
        <VBox spacing="16" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>

            <!-- Empty State -->
            <Label fx:id="emptyStateLabel"
                   text="No bookings yet. Book your first trip!"
                   styleClass="empty-state-label"
                   managed="false" visible="false"/>

            <!-- Booking Table -->
            <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="bookingIdColumn" text="Booking ID" prefWidth="100"/>
                    <TableColumn fx:id="busNumberColumn" text="Bus Number" prefWidth="120"/>
                    <TableColumn fx:id="sourceColumn" text="Source" prefWidth="130"/>
                    <TableColumn fx:id="destinationColumn" text="Destination" prefWidth="130"/>
                    <TableColumn fx:id="seatNumberColumn" text="Seat" prefWidth="70"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- ===== BOTTOM ===== -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="← Back to Dashboard"
                    onAction="#handleBack"
                    styleClass="secondary-button"/>
        </HBox>
    </bottom>

</BorderPane>
