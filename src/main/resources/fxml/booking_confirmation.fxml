<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.BookingController">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #1e90ff;">
            <Label text="Booking Confirmed 🎉"
                   style="-fx-font-size: 22px;
                          -fx-text-fill: white;
                          -fx-font-weight: bold;" />
            <Label text="Your bus ticket has been successfully booked"
                   style="-fx-text-fill: white;" />
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <GridPane alignment="CENTER"
                  hgap="15"
                  vgap="12">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Labels -->
            <Label text="Booking ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Bus Number:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label text="Route:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label text="Seat Number:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label text="Travel Date:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label text="Total Fare:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>

            <!-- Dynamic Values -->
            <Label fx:id="bookingIdLabel"
                   text="BK12345"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

            <Label fx:id="busNumberLabel"
                   text="MH01-1234"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

            <Label fx:id="routeLabel"
                   text="Mumbai → Pune"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

            <Label fx:id="seatNumberLabel"
                   text="12"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

            <Label fx:id="travelDateLabel"
                   text="2026-01-20"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

            <Label fx:id="fareLabel"
                   text="₹500"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="1"/>

        </GridPane>
    </center>

    <!-- ===== BOTTOM BUTTONS ===== -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="Book Another Ticket"
                    onAction="#handleBookAnother"
                    style="-fx-background-color: #32cd32;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />

            <Button text="Exit"
                    onAction="#handleExit"
                    style="-fx-background-color: #dc143c;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
