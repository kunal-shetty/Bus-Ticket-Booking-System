<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.BookingController"
            prefWidth="800" prefHeight="600">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox alignment="CENTER" spacing="4" styleClass="page-header-accent">
            <padding>
                <Insets top="24" right="20" bottom="24" left="20"/>
            </padding>

            <Label text="✅ Booking Confirmed!"
                   styleClass="header-label"/>

            <Label text="Your bus ticket has been successfully booked"
                   styleClass="sub-header"
                   style="-fx-text-fill: rgba(255,255,255,0.8);"/>
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="30" right="50" bottom="20" left="50"/>
            </padding>

            <GridPane alignment="CENTER" hgap="20" vgap="16"
                      styleClass="confirmation-card" maxWidth="450">
                <padding>
                    <Insets top="30" right="40" bottom="30" left="40"/>
                </padding>

                <Label text="Booking ID" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="bookingIdLabel" text="—"
                       styleClass="highlight-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Bus Number" styleClass="field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="busNumberLabel" text="—"
                       styleClass="value-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Route" styleClass="field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="routeLabel" text="—"
                       styleClass="value-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Seat Number" styleClass="field-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="seatNumberLabel" text="—"
                       styleClass="value-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Travel Date" styleClass="field-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="travelDateLabel" text="—"
                       styleClass="value-label"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <!-- Divider -->
                <Region styleClass="divider"
                        GridPane.rowIndex="5" GridPane.columnIndex="0"
                        GridPane.columnSpan="2"/>

                <Label text="Total Fare" styleClass="field-label"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Label fx:id="fareLabel" text="—"
                       styleClass="fare-label"
                       GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </center>

    <!-- ===== BOTTOM BUTTONS ===== -->
    <bottom>
        <HBox alignment="CENTER" spacing="16">
            <padding>
                <Insets top="15" right="20" bottom="25" left="20"/>
            </padding>

            <Button text="🎟 Book Another Ticket"
                    onAction="#handleBookAnother"
                    styleClass="primary-button"/>

            <Button text="Exit"
                    onAction="#handleExit"
                    styleClass="secondary-button"/>
        </HBox>
    </bottom>

</BorderPane>
