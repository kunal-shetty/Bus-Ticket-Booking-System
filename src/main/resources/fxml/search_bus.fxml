<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.SearchBusController"
            prefWidth="800" prefHeight="600">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox spacing="4" alignment="CENTER" styleClass="page-header">
            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <Label text="🔍 Search Buses"
                   styleClass="header-label"/>

            <Label text="Find available buses by route"
                   styleClass="sub-header"/>
        </VBox>
    </top>

    <!-- ===== CENTER CONTENT ===== -->
    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <!-- Search Inputs -->
            <HBox spacing="12" alignment="CENTER">
                <TextField fx:id="sourceField"
                           promptText="Source city"
                           prefWidth="180"/>

                <TextField fx:id="destinationField"
                           promptText="Destination city"
                           prefWidth="180"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        styleClass="primary-button"/>

                <Button text="Show All"
                        onAction="#handleShowAll"
                        styleClass="secondary-button"/>
            </HBox>

            <!-- Result Table -->
            <TableView fx:id="busTable"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="busIdColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="busNumberColumn"
                                 text="Bus Number"
                                 prefWidth="150"/>

                    <TableColumn fx:id="sourceColumn"
                                 text="Source"
                                 prefWidth="140"/>

                    <TableColumn fx:id="destinationColumn"
                                 text="Destination"
                                 prefWidth="140"/>

                    <TableColumn fx:id="seatsColumn"
                                 text="Total Seats"
                                 prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Message -->
            <Label fx:id="messageLabel" text=""
                   styleClass="error-label"/>

            <!-- Action Buttons -->
            <HBox spacing="16" alignment="CENTER">
                <Button text="Select Bus →"
                        onAction="#handleSelectBus"
                        styleClass="success-button"/>

                <Button text="← Back to Dashboard"
                        onAction="#handleBack"
                        styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
