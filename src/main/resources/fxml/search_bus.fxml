<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.SearchBusController">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox spacing="10"
              alignment="CENTER"
              style="-fx-background-color: #1e90ff;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="🔍 Search Buses"
                   style="-fx-font-size: 20px;
                          -fx-text-fill: white;
                          -fx-font-weight: bold;" />

            <Label text="Find available buses by route"
                   style="-fx-text-fill: white;" />
        </VBox>
    </top>

    <!-- ===== SEARCH FORM ===== -->
    <center>
        <VBox spacing="20"
              alignment="TOP_CENTER">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Search Inputs -->
            <HBox spacing="15"
                  alignment="CENTER">

                <TextField fx:id="sourceField"
                           promptText="Source"
                           prefWidth="180"/>

                <TextField fx:id="destinationField"
                           promptText="Destination"
                           prefWidth="180"/>

                <Button text="Search"
                        onAction="#handleSearch"
                        style="-fx-background-color: #1e90ff;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;" />
            </HBox>

            <!-- Result Table -->
            <TableView fx:id="busTable"
                       prefHeight="300"
                       prefWidth="650">

                <columns>
                    <TableColumn fx:id="busIdColumn"
                                 text="Bus ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="busNumberColumn"
                                 text="Bus Number"
                                 prefWidth="150"/>

                    <TableColumn fx:id="sourceColumn"
                                 text="Source"
                                 prefWidth="140"/>

                    <TableColumn fx:id="destinationColumn"
                                 text="Destination"
                                 prefWidth="140"/>

                    <TableColumn fx:id="seatsColumn"
                                 text="Seats"
                                 prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Message / Error -->
            <Label fx:id="messageLabel"
                   text=""
                   style="-fx-text-fill: red;" />

            <!-- Action Buttons -->
            <HBox spacing="20"
                  alignment="CENTER">

                <Button text="Select Bus"
                        onAction="#handleSelectBus"
                        style="-fx-background-color: #32cd32;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;" />

                <Button text="Back"
                        onAction="#handleBack"
                        style="-fx-background-color: #dc143c;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
