<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.LoginController"
            prefWidth="800" prefHeight="600">

    <center>
        <VBox alignment="CENTER" spacing="24">
            <padding>
                <Insets top="60" right="60" bottom="60" left="60"/>
            </padding>

            <Label text="🚌 Bus Ticket Booking"
                   styleClass="header-label"/>

            <Label text="Sign in to manage your bookings"
                   styleClass="sub-header"/>

            <Region prefHeight="10"/>

            <GridPane hgap="12" vgap="16" alignment="CENTER" styleClass="card"
                      maxWidth="420">
                <padding>
                    <Insets top="35" right="35" bottom="35" left="35"/>
                </padding>

                <Label text="Email" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           promptText="you@example.com"
                           prefWidth="260"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Password" styleClass="field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               prefWidth="260"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                <HBox spacing="12" alignment="CENTER_RIGHT"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="0"
                      GridPane.columnSpan="2">
                    <Button text="Sign In"
                            prefWidth="130"
                            onAction="#handleLogin"
                            styleClass="primary-button"/>

                    <Button text="Register"
                            onAction="#handleRegister"
                            styleClass="ghost-button"/>
                </HBox>
            </GridPane>

            <Label fx:id="messageLabel" text=""
                   styleClass="error-label"/>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="10" bottom="15"/>
            </padding>
            <Label text="© 2026 Bus Ticket Booking System"
                   styleClass="footer-label"/>
        </VBox>
    </bottom>

</BorderPane>
