<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.LoginController">

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;">

            <!-- VBox padding -->
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="🚌 Bus Ticket Booking System"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Login to continue"
                   style="-fx-text-fill: #555;"/>

            <GridPane hgap="10" vgap="15" alignment="CENTER"
                      style="-fx-background-color: white;
                             -fx-border-color: #ddd;
                             -fx-border-radius: 5;
                             -fx-background-radius: 5;">

                <!-- GridPane padding -->
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           promptText="Enter your email"
                           prefWidth="250"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               prefWidth="250"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                <Button text="Login"
                        prefWidth="120"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"
                        onAction="#handleLogin"
                        style="-fx-background-color: #1e90ff;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>
            </GridPane>

            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>

            <Hyperlink text="New user? Register here"
                       onAction="#handleRegister"/>

        </VBox>
    </center>

</BorderPane>
