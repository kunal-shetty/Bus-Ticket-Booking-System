<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.SeatSelectionController">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox alignment="CENTER"
              spacing="5"
              padding="15"
              style="-fx-background-color: #1e90ff;">

            <Label text="💺 Seat Selection"
                   style="-fx-font-size: 20px;
                          -fx-text-fill: white;
                          -fx-font-weight: bold;" />

            <Label fx:id="busInfoLabel"
                   text="Bus: MH01-1234 | Mumbai → Pune"
                   style="-fx-text-fill: white;" />
        </VBox>
    </top>

    <!-- ===== CENTER SEAT GRID ===== -->
    <center>
        <VBox alignment="CENTER"
              spacing="20"
              padding="20">

            <!-- Seat Legend -->
            <HBox spacing="20"
                  alignment="CENTER">

                <HBox spacing="5" alignment="CENTER">
                    <Label text="🟩"/>
                    <Label text="Available"/>
                </HBox>

                <HBox spacing="5" alignment="CENTER">
                    <Label text="🟥"/>
                    <Label text="Booked"/>
                </HBox>

                <HBox spacing="5" alignment="CENTER">
                    <Label text="🟦"/>
                    <Label text="Selected"/>
                </HBox>
            </HBox>

            <!-- Scrollable Seat Area -->
            <ScrollPane prefWidth="500"
                        prefHeight="350"
                        fitToWidth="true">

                <GridPane fx:id="seatGrid"
                          alignment="CENTER"
                          hgap="10"
                          vgap="10"
                          padding="20">
                    <!-- Seats will be generated dynamically -->
                </GridPane>

            </ScrollPane>

            <!-- Selected Seat Info -->
            <Label fx:id="selectedSeatLabel"
                   text="Selected Seat: None"
                   style="-fx-font-weight: bold;" />
        </VBox>
    </center>

    <!-- ===== BOTTOM ACTIONS ===== -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="20"
              padding="15">

            <Button text="Confirm Booking"
                    onAction="#handleConfirmBooking"
                    style="-fx-background-color: #32cd32;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />

            <Button text="Back"
                    onAction="#handleBack"
                    style="-fx-background-color: #dc143c;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
