<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.SeatSelectionController"
            prefWidth="800" prefHeight="600">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <VBox alignment="CENTER" spacing="4" styleClass="page-header">
            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <Label text="💺 Seat Selection"
                   styleClass="header-label"/>

            <Label fx:id="busInfoLabel"
                   text="Bus: MH01-1234  |  Mumbai → Pune"
                   styleClass="sub-header"/>
        </VBox>
    </top>

    <!-- ===== CENTER SEAT GRID ===== -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>

            <!-- Seat Legend -->
            <HBox spacing="30" alignment="CENTER">
                <HBox spacing="8" alignment="CENTER">
                    <Region styleClass="legend-dot, legend-dot-available"/>
                    <Label text="Available" styleClass="info-label"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER">
                    <Region styleClass="legend-dot, legend-dot-booked"/>
                    <Label text="Booked" styleClass="info-label"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER">
                    <Region styleClass="legend-dot, legend-dot-selected"/>
                    <Label text="Selected" styleClass="info-label"/>
                </HBox>
            </HBox>

            <!-- Scrollable Seat Area -->
            <ScrollPane prefWidth="450"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS">
                <GridPane fx:id="seatGrid"
                          alignment="CENTER"
                          hgap="8"
                          vgap="8">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>
                </GridPane>
            </ScrollPane>

            <!-- Selected Seat Info -->
            <Label fx:id="selectedSeatLabel"
                   text="Select a seat to continue"
                   styleClass="info-label"/>
        </VBox>
    </center>

    <!-- ===== BOTTOM ACTIONS ===== -->
    <bottom>
        <HBox alignment="CENTER" spacing="16">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="✓ Confirm Booking"
                    onAction="#handleConfirmBooking"
                    styleClass="success-button"/>

            <Button text="← Back"
                    onAction="#handleBack"
                    styleClass="secondary-button"/>
        </HBox>
    </bottom>

</BorderPane>
