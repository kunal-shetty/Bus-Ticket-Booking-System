<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.RegisterController"
            prefWidth="800" prefHeight="600">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>

            <Label text="📝 Create Account"
                   styleClass="header-label"/>

            <Label text="Register to start booking bus tickets"
                   styleClass="sub-header"/>

            <Region prefHeight="8"/>

            <GridPane hgap="12" vgap="14" alignment="CENTER" styleClass="card"
                      maxWidth="450">
                <padding>
                    <Insets top="30" right="35" bottom="30" left="35"/>
                </padding>

                <Label text="Full Name" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField"
                           promptText="Your full name"
                           prefWidth="260"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Email" styleClass="field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField"
                           promptText="you@example.com"
                           prefWidth="260"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Password" styleClass="field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField"
                               promptText="Min 6 characters"
                               prefWidth="260"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                <Label text="Confirm" styleClass="field-label"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Re-enter password"
                               prefWidth="260"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                <HBox spacing="12" alignment="CENTER_RIGHT"
                      GridPane.rowIndex="4"
                      GridPane.columnIndex="0"
                      GridPane.columnSpan="2">
                    <Button text="Register"
                            prefWidth="130"
                            onAction="#handleRegister"
                            styleClass="success-button"/>

                    <Button text="Back to Login"
                            onAction="#handleBackToLogin"
                            styleClass="ghost-button"/>
                </HBox>
            </GridPane>

            <Label fx:id="messageLabel" text=""
                   styleClass="error-label"/>
        </VBox>
    </center>

</BorderPane>
