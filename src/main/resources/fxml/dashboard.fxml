<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.DashboardController"
            prefWidth="800" prefHeight="600">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="🚌 Bus Ticket Booking"
                   styleClass="header-label"/>

            <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel"
                       text="Welcome, User"
                       styleClass="info-label"/>
            </HBox>
        </HBox>
    </top>

    <!-- ===== CENTER DASHBOARD ===== -->
    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding>
                <Insets top="50" right="50" bottom="30" left="50"/>
            </padding>

            <Label text="What would you like to do?"
                   styleClass="sub-header"/>

            <Region prefHeight="5"/>

            <GridPane alignment="CENTER" hgap="24" vgap="24">
                <Button text="🔍  Search Buses"
                        prefWidth="240" prefHeight="90"
                        styleClass="primary-button, dashboard-button"
                        onAction="#handleSearchBuses"/>

                <Button text="🎟  Book a Ticket"
                        prefWidth="240" prefHeight="90"
                        GridPane.columnIndex="1"
                        styleClass="success-button, dashboard-button"
                        onAction="#handleBookTicket"/>

                <Button text="📄  Booking History"
                        prefWidth="240" prefHeight="90"
                        GridPane.rowIndex="1"
                        styleClass="secondary-button, dashboard-button"
                        onAction="#handleBookingHistory"/>

                <Button text="🚪  Logout"
                        prefWidth="240" prefHeight="90"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"
                        onAction="#handleLogout"
                        styleClass="danger-button, dashboard-button"/>
            </GridPane>
        </VBox>
    </center>

    <!-- ===== FOOTER ===== -->
    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="10" bottom="15"/>
            </padding>
            <Label text="© 2026 Bus Ticket Booking System"
                   styleClass="footer-label"/>
        </VBox>
    </bottom>

</BorderPane>
