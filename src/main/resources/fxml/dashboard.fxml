<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.busbooking.controller.DashboardController">

    <!-- ===== TOP HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="🚌 Bus Ticket Booking System"
                   styleClass="header-label" />

            <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeLabel"
                       text="Welcome, User"
                       styleClass="info-label"
                       style="-fx-text-fill: white;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ===== CENTER DASHBOARD ===== -->
    <center>
        <GridPane alignment="CENTER" hgap="30" vgap="30">

            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Button text="🔍 Search Buses"
                    prefWidth="220"
                    prefHeight="80"
                    styleClass="primary-button"
                    style="-fx-font-size: 16px;"
                    onAction="#handleSearchBuses"/>

            <Button text="🎟 Book Ticket"
                    prefWidth="220"
                    prefHeight="80"
                    GridPane.columnIndex="1"
                    styleClass="success-button"
                    style="-fx-font-size: 16px;"
                    onAction="#handleBookTicket"/>

            <Button text="📄 Booking History"
                    prefWidth="220"
                    prefHeight="80"
                    GridPane.rowIndex="1"
                    styleClass="secondary-button"
                    style="-fx-font-size: 16px;"
                    onAction="#handleBookingHistory"/>

            <Button text="🚪 Logout"
                    prefWidth="220"
                    prefHeight="80"
                    GridPane.rowIndex="1"
                    GridPane.columnIndex="1"
                    onAction="#handleLogout"
                    styleClass="danger-button"
                    style="-fx-font-size: 16px;"/>
        </GridPane>
    </center>

    <!-- ===== FOOTER ===== -->
    <bottom>
        <VBox alignment="CENTER">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="© 2026 Bus Ticket Booking System"
                   style="-fx-text-fill: #555;" />
        </VBox>
    </bottom>

</BorderPane>
